# Secrets du site Next.js. Copier en .env.local et remplir.
# Ces valeurs sont AUSSI à poser dans les variables d'environnement Vercel.
#
# ⚠️ Aucune de ces variables ne doit jamais porter le préfixe NEXT_PUBLIC_ :
# il publie la valeur dans le code source de la page, sans aucun avertissement.

# La porte du site. Le tirer au hasard, ne pas le choisir de tête :
#   python3 -c "import secrets;print('-'.join(''.join(secrets.choice('abcdefghijkmnpqrstuvwxyz23456789') for _ in range(4)) for _ in range(6)))"
MOT_DE_PASSE_SITE=

# Signe le cookie de session. Qui détient cette valeur peut fabriquer un cookie
# valide SANS connaître le mot de passe : elle vaut exactement autant que lui.
#   python3 -c "import secrets;print(secrets.token_hex(32))"
SECRET_SESSION=
