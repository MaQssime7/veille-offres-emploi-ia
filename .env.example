FT_CLIENT_ID=
FT_CLIENT_SECRET=
ANTHROPIC_API_KEY=

# Supabase — Settings > API Keys, onglet « Clés API publiques et secrètes ».
# La clé secrète (sb_secret_...) contourne toute la sécurité de la base : elle
# reste côté serveur, jamais dans une variable NEXT_PUBLIC_*.
# La clé publiable (sb_publishable_...) ne sert pas ici — le navigateur ne parle
# jamais directement à Supabase.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Clé publiable — sert uniquement au test de vérification de RLS, pas au produit.
SUPABASE_PUBLISHABLE_KEY=

# Mot de passe Postgres — migrations uniquement, jamais déployé.
SUPABASE_DB_PASSWORD=
